# ==============================================================================
# FRONTEND CONFIGURATION (Vercel / Local Vite)
# ==============================================================================

# Backend API base URL:
# Local dev: http://127.0.0.1:8000
# Production Render: https://vibro-ai-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend WebSocket streaming URL:
# Local dev: ws://127.0.0.1:8000
# Production Render: wss://vibro-ai-backend.onrender.com
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Refresh & synchronization intervals (milliseconds)
VITE_DEFAULT_ENGINE_ID=1
VITE_DIGITAL_TWIN_REFRESH_INTERVAL_MS=2000
VITE_BACKEND_SYNC_INTERVAL_MS=2000
VITE_BACKEND_VIBRATION_SYNC_INTERVAL_MS=4000
VITE_ENABLE_BACKEND_SYNC=true

# ==============================================================================
# BACKEND CONFIGURATION (Render / Local FastAPI)
# ==============================================================================

# Web server port (Render automatically provides $PORT)
PORT=8000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://vibro-ai-main.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Database connection URL:
# Local development: defaults to SQLite (sqlite:///./vibro_ai.db)
# Production with Render PostgreSQL: postgresql://user:password@hostname:5432/dbname
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
